# ---------- runtime ----------
ENV=development
DEBUG=false
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PREFIX=/api
LOG_LEVEL=INFO

# ---------- database ----------
# Dev default is SQLite. Production: postgresql+asyncpg://armx:armx@postgres:5432/armx
DATABASE_URL=sqlite+aiosqlite:///./armx.db
AUTO_CREATE_TABLES=true
# REDIS_URL=redis://redis:6379/0

# ---------- auth (REQUIRED in production) ----------
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# ---------- LLM ----------
# claude | openai | mock.  "mock" is the deterministic offline planner.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Optional pool of the owner's OWN keys from the same Anthropic org (comma separated).
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HARNESS_MAX_STEPS=8

# ---------- email (needed for password reset in production) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@armx.example
SMTP_TLS=true

# ---------- google oauth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------- smart home ----------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWED_ENTITIES=light.living_room,light.desk,switch.fan
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true

# ---------- search ----------
SEARCH_PROVIDER=none
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_SEARCH_API_KEY=

# ---------- build & deploy pipeline ----------
# simulated = full flow with clearly-labelled fake targets; live = real API calls
PIPELINE_MODE=simulated
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=
GITHUB_ALLOWED_TARGETS=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ALLOWED_PROJECT_PREFIX=armx-
TURSO_API_TOKEN=
TURSO_ORG=
PROJECT_WORKSPACE=./var/workspace

# ---------- messaging ----------
MESSAGING_MODE=simulated
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
MESSENGER_TOKEN=
MESSENGER_PAGE_ID=

# ---------- read-only mail ----------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------- policy ----------
TOOL_RATE_LIMIT_PER_MINUTE=30
APPROVAL_TTL_SECONDS=120
