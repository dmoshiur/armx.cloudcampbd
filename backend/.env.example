# ---------- runtime ----------
ENV=development
DEBUG=false
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PREFIX=/api
LOG_LEVEL=INFO

# ---------- database ----------
# Dev default is SQLite. Render production uses the paired Turso values; when
# set, the application automatically selects its embedded-replica dialect.
DATABASE_URL=sqlite+aiosqlite:///./armx.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_REPLICA_PATH=./var/turso-replica.db
TURSO_SYNC_INTERVAL_SECONDS=30
REQUIRE_TURSO_IN_PRODUCTION=false
AUTO_CREATE_TABLES=true
REDIS_URL=

# ---------- auth (REQUIRED in production) ----------
# APP_BASE_URL is the absolute public origin used in auth emails. Production
# requires https://; WEB_ORIGIN remains the CORS/fallback origin.
APP_BASE_URL=
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_REFRESH_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false
ACCESS_COOKIE_NAME=armx_access
REFRESH_COOKIE_NAME=armx_refresh
CSRF_COOKIE_NAME=armx_csrf

# Set both for one-time environment bootstrap, or INITIAL_SETUP_TOKEN for /setup.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_DISPLAY_NAME=Platform owner
INITIAL_SETUP_TOKEN=

# ---------- LLM ----------
# groq | claude | openai | mock. Database routes take over when configured.
LLM_PROVIDER=mock
LLM_ROUTING_STRATEGY=balanced
# Generate with Fernet.generate_key(); required whenever any live key is set.
LLM_SECRETS_KEY=
# Chat latency budgets: one provider attempt, full failover route, then request.
LLM_TIMEOUT_SECONDS=25
LLM_ROUTE_TIMEOUT_SECONDS=45
ASSISTANT_REQUEST_TIMEOUT_SECONDS=50
LLM_MAX_TOKENS=4096
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
# Optional pool of the owner's OWN keys from the same Anthropic org (comma separated).
ANTHROPIC_API_KEYS=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
HARNESS_MAX_STEPS=8

# ---------- transactional email (official Resend REST API; no SMTP required) ----------
# All values stay server-side. See docs/RESEND_SETUP.md.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional signed webhook secret for delivered/bounced/complained/failed status.
RESEND_WEBHOOK_SECRET=
RESEND_API_URL=https://api.resend.com/emails
RESEND_MAX_ATTEMPTS=3
RESEND_TIMEOUT_SECONDS=10
# SMTP is NOT used by authentication email. Legacy SMTP variables may remain in
# an existing deployment but are ignored; do not add new SMTP credentials.

# ---------- google oauth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------- smart home ----------
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWED_ENTITIES=light.living_room,light.desk,switch.fan
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true

# ---------- search ----------
SEARCH_PROVIDER=none
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_SEARCH_API_KEY=

# ---------- build & deploy pipeline ----------
# simulated = full flow with clearly-labelled fake targets; live = real API calls
PIPELINE_MODE=simulated
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=
GITHUB_ALLOWED_TARGETS=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ALLOWED_PROJECT_PREFIX=armx-
TURSO_API_TOKEN=
TURSO_ORG=
PROJECT_WORKSPACE=./var/workspace

# ---------- messaging ----------
MESSAGING_MODE=simulated
# Meta access token + sender phone ID (outbound)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Separate random webhook challenge token + Meta App Secret (inbound verification)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MESSENGER_TOKEN=
MESSENGER_PAGE_ID=

# ---------- read-only mail ----------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------- policy ----------
TOOL_RATE_LIMIT_PER_MINUTE=30
APPROVAL_TTL_SECONDS=120
