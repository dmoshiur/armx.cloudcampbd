# A.R.M.X AI — Render production environment
# Copy variable names into Render > Environment. Never commit filled secrets.
# Render injects PORT and RENDER_EXTERNAL_URL; do not set either manually.

# ---------------------------------------------------------------------------
# Runtime and public origin
# ---------------------------------------------------------------------------
APP_NAME=A.R.M.X AI
ENV=production
DEBUG=false
API_PREFIX=/api
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
# Leave blank on Render: entrypoint derives both from RENDER_EXTERNAL_URL.
WEB_ORIGIN=
CORS_ORIGINS=

# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Turso application database (required by this production template)
# ---------------------------------------------------------------------------
REQUIRE_TURSO_IN_PRODUCTION=true
# Turso dashboard database URL, e.g. libsql://armx-your-org.turso.io
TURSO_DATABASE_URL=
# Database auth token, not the Turso platform API token.
TURSO_AUTH_TOKEN=
# Local embedded replica; mount a Render disk at /data for faster restarts.
TURSO_REPLICA_PATH=/data/turso-replica.db
TURSO_SYNC_INTERVAL_SECONDS=30
DB_ECHO=false

# Redis is intentionally not required for a single Render API instance. If you
# later run multiple HTTP replicas, set REDIS_URL and add a shared limiter.
REDIS_URL=

# ---------------------------------------------------------------------------
# First superadmin — choose ONE bootstrap method
# ---------------------------------------------------------------------------
# Method A (simplest): set both values for first deploy. Once login works,
# remove FIRST_ADMIN_PASSWORD from Render; startup never rotates an existing user.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_DISPLAY_NAME=Platform owner

# Method B: leave FIRST_ADMIN_* blank and generate a protected setup token:
#   openssl rand -base64 48
# Open /setup, enter this token once, then remove it from Render.
INITIAL_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# Multi-provider LLM routing — Groq/Llama is the default primary
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_ROUTING_STRATEGY=balanced
# Generate exactly once and keep stable, or stored provider keys cannot decrypt:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SECRETS_KEY=
# Chat latency budgets: one provider attempt, full failover route, then request.
LLM_TIMEOUT_SECONDS=25
LLM_ROUTE_TIMEOUT_SECONDS=45
ASSISTANT_REQUEST_TIMEOUT_SECONDS=50
LLM_MAX_TOKENS=4096
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
HARNESS_MAX_STEPS=8

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback providers. They are seeded as additional active routes when set.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---------------------------------------------------------------------------
# Email and sign-in (optional; required for real password-reset email)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example
SMTP_TLS=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: https://your-service.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Builder/deployment integrations (optional)
# ---------------------------------------------------------------------------
PIPELINE_MODE=simulated
PROJECT_WORKSPACE=/data/workspace
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=
GITHUB_ALLOWED_TARGETS=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_ALLOWED_PROJECT_PREFIX=armx-
# These TURSO_* values are for provisioning databases for generated projects,
# not the application database credentials above.
TURSO_API_TOKEN=
TURSO_ORG=
TURSO_BASE_URL=https://api.turso.tech

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=none
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
BING_SEARCH_API_KEY=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOWED_ENTITIES=light.living_room,light.desk,switch.fan
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=true
MESSAGING_MODE=simulated
# Meta access token + sender phone ID (outbound)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Separate random webhook challenge token + Meta App Secret (inbound verification)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MESSENGER_TOKEN=
MESSENGER_PAGE_ID=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------
TOOL_RATE_LIMIT_PER_MINUTE=30
APPROVAL_TTL_SECONDS=120
MAX_UPLOAD_BYTES=8388608
