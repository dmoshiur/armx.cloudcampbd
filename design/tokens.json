{
  "$comment": "Single source of truth for the A.R.M.X CMatrix design system. Consumed by the web Tailwind config, mobile themes and deploy-pipeline design lint. Do not edit colours in app code.",
  "color": {
    "ink": "#020904",
    "navy": "#06120A",
    "accent": "#00FF41",
    "accent2": "#00B82E",
    "fog": "#D7FFE1",
    "line": "#174D24",
    "muted": "#75A881",
    "white": "#FFFFFF",
    "success": "#00D938",
    "warning": "#F5C542",
    "danger": "#FF4D67"
  },
  "semantic": {
    "dark": {
      "background": "ink",
      "surface": "navy",
      "text": "#D7FFE1",
      "textMuted": "#75A881",
      "border": "#174D24",
      "primary": "accent",
      "primaryContrast": "#001A07"
    },
    "light": {
      "background": "#ECFFF0",
      "surface": "white",
      "text": "#020904",
      "textMuted": "#386B45",
      "border": "#A8DDB4",
      "primary": "accent2",
      "primaryContrast": "#FFFFFF"
    }
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 22, "full": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
  "typography": {
    "family": "\"Inter var\", Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "scale": {
      "display": { "size": 44, "lineHeight": 1.1, "weight": 700, "tracking": -0.02 },
      "h1": { "size": 32, "lineHeight": 1.2, "weight": 700, "tracking": -0.015 },
      "h2": { "size": 24, "lineHeight": 1.25, "weight": 650, "tracking": -0.01 },
      "h3": { "size": 18, "lineHeight": 1.35, "weight": 600, "tracking": 0 },
      "body": { "size": 15, "lineHeight": 1.5, "weight": 400, "tracking": 0 },
      "caption": { "size": 12.5, "lineHeight": 1.45, "weight": 500, "tracking": 0.01 }
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 260 },
    "easing": "cubic-bezier(0.2, 0.7, 0.3, 1)",
    "rules": ["purposeful only", "CMatrix background only", "no parallax", "respect prefers-reduced-motion"]
  },
  "breakpoints": { "compact": 0, "medium": 600, "expanded": 1024 },
  "layout": { "contentMaxWidth": 1200, "touchTargetMin": 48, "railWidth": 84, "sidebarWidth": 264 },
  "states": ["loading", "empty", "error", "success"],
  "rules": {
    "accent_pairing": "accent and accent2 must never appear on the same element",
    "dark_default": true,
    "no_stock_illustration": true,
    "hover_focus_required_from": "medium"
  }
}
